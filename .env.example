# Copier en .env et adapter. Ne jamais committer le vrai .env.

# --- Obligatoire ---
# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=change-me

# Cle de signature des jetons de session (32 caracteres minimum). Generer par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si elle est absente, une cle aleatoire est generee a chaque demarrage (sessions perdues).
KIKAN_SECRET_KEY=

# --- Premier compte (cree seulement si la base ne contient aucun compte) ---
KIKAN_ADMIN_USER=admin
# Si vide, un mot de passe aleatoire est genere et affiche UNE FOIS dans les journaux :
#   docker compose logs api | grep "COMPTE INITIAL"
KIKAN_ADMIN_PASSWORD=

# --- Production ---
# "production" : refuse de demarrer sans KIKAN_SECRET_KEY solide, masque /docs.
KIKAN_ENV=development

# --- Reseau et TLS ---
# Adresse sur laquelle publier l'interface (tablette de signature sur le reseau local).
# Par defaut : 127.0.0.1 (machine locale uniquement).
KIKAN_BIND=127.0.0.1
KIKAN_HTTPS_PORT=3443
# Noms/adresses supplementaires du certificat auto-signe, ex. : DNS:kikan.exemple.local,IP:192.168.1.10
KIKAN_TLS_SAN=

# --- Stockage des PDF scelles ---
# local  : volume Docker (par defaut), qui peut lui-meme etre un lecteur reseau monte sur l'hote
# smb    : depot direct sur un partage reseau Windows/Samba (\\serveur\partage), sans montage
# webdav : depot sur un partage de fichiers web (HTTPS)
# Le PDF est toujours ecrit d'abord en local, depose puis verifie (SHA-256) sur le partage ; si le
# partage est indisponible, la signature reussit et le depot est repris plus tard (Stockage > Reprendre).
KIKAN_STORAGE_BACKEND=local
# SMB : repertoire de base facultatif ; les documents sont ranges par annee (AAAA/).
# KIKAN_SMB_SERVER=fichiers.exemple.local
# KIKAN_SMB_SHARE=kikan
# KIKAN_SMB_PATH=remises
# KIKAN_SMB_USER=svc-kikan
# KIKAN_SMB_PASSWORD=
# KIKAN_SMB_DOMAIN=EXEMPLE
# KIKAN_SMB_ENCRYPT=true        # chiffrement SMB 3 ; false seulement si le serveur ne le gere pas
# WebDAV : URL du dossier cible, identifiants OU jeton.
# KIKAN_WEBDAV_URL=https://partage.exemple.fr/remote.php/dav/files/svc-kikan/kikan
# KIKAN_WEBDAV_USER=svc-kikan
# KIKAN_WEBDAV_PASSWORD=
# KIKAN_WEBDAV_TOKEN=

# SharePoint Online (Microsoft Graph) : KIKAN_STORAGE_BACKEND=sharepoint. Seuls les PDF scelles y sont deposes ; voir docs/SHAREPOINT.md
# KIKAN_SHAREPOINT_TENANT_ID=
# KIKAN_SHAREPOINT_CLIENT_ID=
# KIKAN_SHAREPOINT_CLIENT_SECRET=
# KIKAN_SHAREPOINT_SITE=societe.sharepoint.com:/sites/Kikan
# KIKAN_SHAREPOINT_LIBRARY=Documents
# KIKAN_SHAREPOINT_FOLDER=Kikan

# DocuWare : KIKAN_STORAGE_BACKEND=docuware. Seuls les PDF scelles y sont deposes ; voir docs/DOCUWARE.md
# KIKAN_DOCUWARE_URL=https://societe.docuware.cloud/DocuWare/Platform
# KIKAN_DOCUWARE_USER=svc-kikan
# KIKAN_DOCUWARE_PASSWORD=
# KIKAN_DOCUWARE_CABINET=Kikan
# KIKAN_DOCUWARE_FIELDS={"type":"TYPE_DOC","annee":{"champ":"ANNEE","type":"Int"},"entite":"ENTITE"}
# Certificat du serveur WebDAV : toujours verifie. Pour une autorite interne ou un certificat auto-signe,
# deposer le certificat (PEM) dans ./ca/ et indiquer son chemin dans le conteneur :
# KIKAN_WEBDAV_CA_BUNDLE=/ca/mon-autorite.pem
# KIKAN_STORAGE_TIMEOUT_SEC=15      # delai de connexion
# KIKAN_STORAGE_DEADLINE_SEC=30     # delai maximal d'une operation SMB (defaut : 2 x le delai de connexion)

# --- Signature ---
# Signature manuscrite a l'ecran obligatoire (par defaut). Avec "false", une simple confirmation est
# acceptee (methode "confirmation", moins probante).
# KIKAN_SIGNATURE_MANUSCRITE_OBLIGATOIRE=true

# --- Connexion Microsoft 365 (SSO, facultative) ---
# Voir docs/SSO.md. Tant que ces variables sont absentes, Kikan fonctionne en connexion locale uniquement.
# Adresse publique de Kikan (HTTPS) : l'adresse de retour declaree dans Entra est <adresse>/api/auth/sso/callback
# KIKAN_PUBLIC_URL=https://kikan.exemple.fr   # aussi utilise pour les liens des e-mails
# KIKAN_SSO_TENANT_ID=
# KIKAN_SSO_CLIENT_ID=
# KIKAN_SSO_CLIENT_SECRET=          # secret du client : uniquement ici, jamais dans l'application
# KIKAN_SSO_CA_BUNDLE=/ca/mon-autorite.pem   # si votre reseau inspecte le trafic HTTPS (comme pour WebDAV)
# KIKAN_SSO_PROXY=http://proxy.exemple.fr:3128   # si le serveur sort par un proxy

# --- Chartes ---
# Taille maximale d'une charte deposee (Mo). Conversion des documents Word : service interne 'converter'
# (vide = desactivee, seuls le PDF et le Markdown sont alors acceptes).
# KIKAN_MAX_CHARTE_MB=10
# KIKAN_WORD_CONVERTER_URL=http://converter:8090

# --- Fuseau horaire ---
# Date des noms de fichier des PDF scelles (heure d'ete et d'hiver comprises). Par defaut : Europe/Paris.
# KIKAN_TIMEZONE=Europe/Paris

# --- Limites (valeurs par defaut) ---
# KIKAN_TOKEN_TTL_MIN=240
# KIKAN_LOGIN_MAX_FAILS=5
# KIKAN_LOGIN_WINDOW_SEC=900
# KIKAN_MAX_IMPORT_MB=5
# KIKAN_MAX_IMPORT_ROWS=20000

# --- Sauvegarde (voir docs/SAUVEGARDE.md) ---
# 1) docker compose --profile backup run --rm backup keygen --out /keys   (la cle PRIVEE reste hors du serveur)
# 2) Coller ici la cle PUBLIQUE affichee, et choisir la destination : partage reseau SMB ou dossier.
# KIKAN_BACKUP_RECIPIENT=age1...
# KIKAN_BACKUP_SMB_SERVER=fichiers.exemple.local
# KIKAN_BACKUP_SMB_SHARE=sauvegardes
# KIKAN_BACKUP_SMB_PATH=kikan
# KIKAN_BACKUP_SMB_USER=svc-sauvegarde
# KIKAN_BACKUP_SMB_PASSWORD=
# KIKAN_BACKUP_SMB_DOMAIN=EXEMPLE
# KIKAN_BACKUP_DIR=./backups      # destination dossier, si pas de partage SMB
# KIKAN_BACKUP_KEEP_DAYS=30       # toutes les sauvegardes de moins de 30 jours...
# KIKAN_BACKUP_KEEP_MONTHS=12     # ...plus la premiere de chaque mois pendant 12 mois

# --- GLPI (facultatif) : voir docs/GLPI.md ---
# L'adresse et les reglages se font dans Parametrage > Integrations ; seuls les jetons se mettent ici.
# KIKAN_GLPI_USER_TOKEN=            # jeton d'API du compte de service GLPI
# KIKAN_GLPI_APP_TOKEN=             # jeton d'application, si le client API de GLPI en exige un
# KIKAN_GLPI_CA_BUNDLE=             # autorite de certification interne (facultatif)

# --- E-mails (rappels, rapport mensuel, facultatifs) ---
# Le serveur SMTP se regle dans Parametrage > E-mails. Seul le mot de passe, s'il en faut un, se met ici.
# KIKAN_SMTP_PASSWORD=
